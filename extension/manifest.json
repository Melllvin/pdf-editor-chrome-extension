{
  "manifest_version": 3,
  "name": "Éditeur PDF",
  "version": "0.1.0",
  "description": "Affichez, remplissez et annotez vos PDF directement dans Chrome, puis enregistrez le résultat.",
  "minimum_chrome_version": "128",
  "permissions": ["declarativeNetRequest", "webNavigation", "storage", "contextMenus"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_title": "Ouvrir l'éditeur PDF",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["viewer/viewer.html"],
      "matches": ["<all_urls>"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
